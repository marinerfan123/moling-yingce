FROM node:24.6.0-alpine AS runtime
LABEL org.opencontainers.image.source="comic-canvas" org.opencontainers.image.revision="${RELEASE_SHA}"
WORKDIR /app
ENV NODE_ENV=production COMIC_CANVAS_BOOT=api APP_PROCESS_ROLE=api
COPY apps/api/dist ./apps/api/dist
COPY packages ./packages
USER 10002:10002
HEALTHCHECK --interval=10s --timeout=3s CMD ["node", "-e", "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["node", "apps/api/dist/main.js"]
