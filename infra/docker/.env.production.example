# Copy to .env.production on the server, set restrictive permissions, and fill secrets there.
POSTGRES_DB=open_ai_canvas
POSTGRES_USER=open_ai_canvas
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://open_ai_canvas:change-me@postgres:5432/open_ai_canvas?sslmode=disable
REDIS_URL=redis://redis:6379/0
CANVAS_REGISTRATION_ENABLED=false
CANVAS_CORS_ORIGINS=https://tv.moling.fun
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_DATA_PATH=/data
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_SHUTDOWN_TIMEOUT=10m
CANVAS_AUTO_MIGRATE=false
ENABLE_PROVIDER_PLUGINS=false
CANVAS_WHISPER_BASE_URL=
CANVAS_FFMPEG_PATH=
CANVAS_HTTP_PORT=3300
GOPROXY=https://goproxy.cn,direct
VITE_TLDRAW_LICENSE_KEY=
BUILD_VERSION=1.2.9
