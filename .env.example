NODE_ENV=development
DATABASE_URL=postgres://comic_api:change-me@127.0.0.1:5432/comic_canvas
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
OIDC_ISSUER=http://127.0.0.1:8080/realms/comic-canvas
OIDC_AUDIENCE=comic-api
# Optional; Keycloak uses ${OIDC_ISSUER}/protocol/openid-connect/certs by default.
# OIDC_JWKS_URL=http://127.0.0.1:8080/realms/comic-canvas/protocol/openid-connect/certs
BETA_ACCESS_MODE=off
APP_PROCESS_ROLE=api
RELEASE_SHA=local-dev
IMAGE_DIGEST=sha256:local
S3_BUCKET=comic-canvas-dev
PUBLIC_BASE_URL=http://localhost:3000
API_ORIGIN=http://127.0.0.1:3001
INTERNAL_SERVICE_IDENTITY=api.local
TRUSTED_PROXY_CIDRS=127.0.0.1/32
TRUSTED_PROXY_HOPS=1
CONTROLLED_EGRESS_ENDPOINT=http://controlled-egress:8080
SAFE_FETCH_PROXY_ENDPOINT=http://safe-fetch-proxy:8080
GENERATION_SUBMIT_KMS_KEY_ID=kms-local-generation-submit
WEBHOOK_VERIFICATION_KMS_KEY_ID=kms-local-webhook-verification
API_COLLAB_SESSION_PRIVATE_JWK_FILE=/run/secrets/collab-session-private.jwk
COLLAB_PUBLIC_JWKS_FILE=/run/secrets/collab-public-jwks.json
MEDIA_IMAGE_DIGEST=sha256:local-media
MEDIA_COMPILER_DIGEST=sha256:local-media-compiler

# Upstream 影策 application settings (used by the Go backend and web app).
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_CORS_ORIGINS=http://localhost:3000
ENABLE_PROVIDER_PLUGINS=false
CANVAS_DATA_PATH=./data
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
CANVAS_WHISPER_BASE_URL=
CANVAS_FFMPEG_PATH=
CANVAS_SHUTDOWN_TIMEOUT=10m
CANVAS_AUTO_MIGRATE=true
CANVAS_UPDATER_TOKEN=
CANVAS_UPDATER_SOCKET_DIR=/run/open-ai-canvas-updater
