{
  "name": "@comic-canvas/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./safe-fetch-attestation": {
      "types": "./types/safe-fetch-attestation.d.ts",
